# ==============================================================================
# MED-SYS PRO v4.0 - Configuración de Entorno
# Sistema de Gestión Médica para IPS / Hospitales / Clínicas
# ==============================================================================

# --- BASE DE DATOS (PostgreSQL) --- [OBLIGATORIO]
DATABASE_URL=postgresql://medsys_user:MedSys2026Secure!@localhost:5432/medsys_db

# --- SEGURIDAD --- [OBLIGATORIO]
# Clave secreta para sesiones y storage (mínimo 32 caracteres)
SECRET_KEY=medsys_secret_key_cambie_esto_en_produccion_2026

# Clave para encriptación AES-256 de datos sensibles (opcional, usa SECRET_KEY si no se define)
# ENCRYPTION_KEY=otra_clave_de_32_caracteres_minimo

# --- CORREO ELECTRÓNICO (SMTP) --- [OPCIONAL]
# Para notificaciones, recordatorios de citas, 2FA por email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=notificaciones@miips.com
# SMTP_PASSWORD=contraseña_de_aplicacion

# --- SERVIDOR --- [OPCIONAL]
# Puerto del servidor (default: 8004)
# PORT=8004
# Host del servidor (default: 0.0.0.0)
# HOST=0.0.0.0
