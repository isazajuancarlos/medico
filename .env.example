# ==============================================================================
# medico — Configuración de entorno (backend Rust: medico-api)
# ==============================================================================
# El servidor lee estas variables al arrancar. Copie este archivo a `.env`, o
# expórtelas por el gestor de servicios (systemd EnvironmentFile) en producción.

# --- SEGURIDAD --- [OBLIGATORIO, sin valor por defecto]
# Firma la cookie de sesión. Mínimo 32 caracteres. El servidor RECHAZA arrancar
# si falta o si es un valor conocido de ejemplo: un secreto de relleno es peor
# que ninguno. Genere el suyo, p. ej.:  openssl rand -hex 32
SECRET_KEY=CAMBIE_ESTO_por_un_valor_aleatorio_de_32_o_mas_caracteres

# --- BASE DE DATOS --- [OPCIONAL]
# SQLite local por defecto: el binario la crea al arrancar. Un consultorio en
# sitio no necesita nada más.
# DATABASE_URL=sqlite://medico.db

# --- ALMACENAMIENTO DE IMÁGENES DIAGNÓSTICAS --- [OPCIONAL]
# Carpeta donde se guardan los archivos adjuntos a las historias (radiografías,
# ecografías, PDF de laboratorio). Es DATO DE PACIENTE: manténgala fuera del
# control de versiones y respáldela. El servidor la crea si no existe.
# MEDICO_DIR_IMAGENES=storage/imagenes

# --- FIRMA DE LA HISTORIA CLÍNICA --- [OPCIONAL, recomendado en producción]
# Firma criptográfica (post-cuántica, vía guaca/Quipu) del contenido al firmar
# una historia: detecta cualquier alteración posterior, incluso hecha por debajo
# de la app. Sin claves, la historia se cierra SIN firma (se desactiva con
# gracia). Genere el par con:  medico-api claves-firma
# La privada es SECRETA; la pública puede publicarse para que cualquiera verifique.
# MEDICO_SIGNING_KEY=<clave privada en hex>
# MEDICO_VERIFYING_KEY=<clave pública en hex>

# --- CIFRADO EN REPOSO DE ARCHIVOS --- [OPCIONAL, recomendado en producción]
# Frase para cifrar en reposo las imágenes de paciente (blob de guaca/Quipu).
# Sin ella, los archivos se guardan EN CLARO en el disco (dato sensible, Ley
# 1581). Con ella, un backup robado o el acceso al VPS solo obtiene ciphertext.
# NO se guarda junto a los archivos; derívela de un secreto de despliegue.
# MEDICO_STORAGE_KEY=<frase larga y propia>

# --- SERVIDOR --- [OPCIONAL]
# Puerto de escucha (default: 8000).
# PORT=8000
# Minutos de vida de la sesión (default: 60).
# SESSION_TIMEOUT_MINUTES=60
