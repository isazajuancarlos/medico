# medico.xiliux.com — la demostración pública de medico.
#
# Se copia a /etc/nginx/sites-available/ y se enlaza en sites-enabled/. El bloque
# TLS lo escribe certbot con `certonly --webroot`; las rutas van descomentadas
# porque este archivo se instala DESPUÉS de que el certificado exista. Es el
# mismo patrón que informes.xiliux.com, y por la misma razón: si certbot
# reescribiera este archivo se llevaría por delante el limit_req y las cabeceras.
#
#   ./despliegue/publicar-demo.sh debian@192.99.42.108

# Límite de peticiones. La demostración es pública y sus credenciales están
# publicadas en la propia pantalla de acceso: sin esto, un bucle contra
# /api/acceso agota CPU en el VPS que también sirve oprf.xiliux.com y el
# portafolio. La zona es propia de este sitio para que su tope no se reparta.
#
# 10r/s con ráfaga de 20 deja navegar de sobra —una pantalla pide entre tres y
# seis peticiones— y corta el bucle automatizado.
limit_req_zone $binary_remote_addr zone=medico_demo:10m rate=10r/s;

server {
    listen 80;
    listen [::]:80;
    server_name medico.xiliux.com;

    # Certbot escribe aquí su reto; el resto va a TLS.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name medico.xiliux.com;

    ssl_certificate     /etc/letsencrypt/live/medico.xiliux.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/medico.xiliux.com/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Las imágenes diagnósticas se suben por multipart. El binario tiene su
    # propio tope; aquí se deja algo por encima para que el rechazo lo dé él,
    # con su mensaje, y no nginx con un 413 mudo.
    client_max_body_size 32m;

    # HSTS PROPIO, y no heredado: xiliux.com responde HSTS SIN
    # `includeSubDomains`, así que no cubre a este subdominio. Sin esta línea la
    # primera visita de cada navegador viaja en claro hasta el 301.
    add_header Strict-Transport-Security "max-age=31536000" always;
    # Aquí NO van X-Frame-Options, X-Content-Type-Options ni Referrer-Policy:
    # las pone el binario en TODA respuesta, junto con la CSP. `add_header` no
    # sustituye lo que llega del proxy_pass: AÑADE, y una cabecera duplicada con
    # valores distintos puede acabar descartada por el navegador.

    # La demostración NO debe indexarse: sus credenciales son públicas y una
    # búsqueda de «historia clínica» no debe llevar a una base que cualquiera
    # puede escribir.
    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        limit_req zone=medico_demo burst=20 nodelay;

        # `Secure` en la cookie de sesión lo pone AQUÍ, no el binario:
        # `sesion.rs` la deja sin esa marca a propósito para que la instalación
        # de consultorio —HTTP en localhost— pueda guardarla. El TLS termina en
        # nginx, y solo aquí se sabe que se puede prometer.
        proxy_cookie_flags ~ secure;

        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        # MEDICO_TRAS_PROXY=true hace que el freno al ensayo de contraseñas lea
        # ESTA cabecera. Se escribe con $remote_addr, que PISA lo que mande el
        # cliente; X-Forwarded-For se añade para el resto del mundo pero el
        # binario no la mira, porque su primer salto lo elige quien llama.
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
